# ════════════════════════════════════════════════════════════════
# PNGTuber Bot — Configuration
# ════════════════════════════════════════════════════════════════

# Token du bot Discord (requis)
DISCORD_TOKEN=

# Port du serveur HTTP (défaut: 3000)
LEVELS_PORT=3000

# Secret HMAC pour les tokens utilisateur (auto-généré au premier démarrage)
# USER_HASH_SECRET=

# ── OAuth2 Discord (optionnel — requis pour l'authentification web) ──

# ID de l'administrateur Discord autorisé à accéder à l'interface
ADMIN_DISCORD_ID=

# Identifiants OAuth2 depuis https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://mon-domaine.exemple.com/auth/callback

# Secret pour signer les cookies de session (auto-généré au premier démarrage)
# SESSION_SECRET=

# ── URL publique (reverse proxy) ──
# URL de base du service derrière le reverse proxy (ex: Pangolin, Caddy, nginx)
# Si non défini, déduit depuis DISCORD_REDIRECT_URI, sinon http://localhost:PORT
# BASE_URL=https://mon-domaine.exemple.com

# ── CORS (optionnel) ──
# Origines supplémentaires autorisées, séparées par des virgules
# CORS_ORIGINS=https://mon-domaine.exemple.com

# ── Docker ──
# DATA_ROOT=/app/data     (défini automatiquement dans docker-compose)

# ── Sécurité réseau ──
# Activer si derrière un reverse proxy (nginx, Caddy, Pangolin, etc.)
# Permet de lire l'IP client depuis X-Forwarded-For pour le rate limiting
# TRUST_PROXY=true

# ── Divers ──
# Mettre 1 pour désactiver l'ouverture auto du navigateur (recommandé en production)
# PNGTUBER_NO_BROWSER=1
